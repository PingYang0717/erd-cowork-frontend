# Base path the frontend prefixes onto every API call (api/apiClient.ts).
# MSW registers its handlers at /api/*, so mock mode needs this to be /api.
VITE_API_BASE_URL=/api

# Transport: unset/mock = MSW serves everything; live = the endpoints a real backend
# implements (sessions read, messages SSE, session files, artifact HTML/repair) go to
# VITE_API_BASE_URL and MSW keeps serving the rest (config/transport.ts).
# VITE_AGENT_TRANSPORT=live
